NODE_ENV=development
PORT=3000

# SQLite 数据库（相对路径基于进程 cwd；桌面版由壳注入绝对路径）
DATABASE_URL=file:./data/yunwu.db

# 任务执行（与 API 同进程运行，无需 Redis/独立 Worker）
TASK_WORKER_ENABLED=true
TASK_WORKER_CONCURRENCY=50
TASK_BATCH_WORKER_CONCURRENCY=2

# 资产存储：local（默认，本地文件） | s3（远端对象存储，需配置 S3_*）
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage
# 可选：显式覆盖资产对外访问地址；默认使用相对路径 /api/assets
PUBLIC_ASSET_BASE_URL=

# S3 兼容对象存储（可选）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# 图像上游：apixo（默认，APIXO Generation API，异步任务式） | openai-compatible（Yunwu）
PROVIDER_TYPE=apixo

# APIXO 上游（https://apixo.ai/docs）
APIXO_BASE_URL=https://api.apixo.ai/api/v1
APIXO_API_KEY=
# 任务轮询超时（毫秒）
APIXO_POLL_TIMEOUT_MS=600000

# Yunwu / OpenAI 兼容上游（PROVIDER_TYPE=openai-compatible 时使用）
YUNWU_BASE_URL=https://yunwu.ai
YUNWU_API_KEY=

# 本地内置账号
AUTH_ADMIN_EMAIL=admin@yunwu.local
AUTH_ADMIN_PASSWORD=admin123456
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_DEMO_EMAIL=demo@yunwu.local
AUTH_DEMO_PASSWORD=demo123456
AUTH_DEMO_DISPLAY_NAME=Demo User
AUTH_SESSION_SECRET=yunwu-dev-session-secret-change-me
AUTH_COOKIE_NAME=yunwu_session
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false

# Web / CORS
# 开发模式（Vite dev server 独立端口）时保留 5173 来源；
# 生产/桌面模式 Web 与 API 同端口，无跨域
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
WEB_ORIGIN=http://127.0.0.1:5173

# 生产/桌面模式：API 进程直接托管 Web 构建产物（留空则不托管）
WEB_DIST_DIR=

# 开发模式 Vite 变量
VITE_API_BASE_URL=http://127.0.0.1:3000/api
